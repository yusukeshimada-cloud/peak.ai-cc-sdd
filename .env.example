# データベース接続設定
# このファイルを .env にコピーして実際の値を設定してください
# .env は .gitignore で管理対象外にしてください

DB_URL=jdbc:postgresql://localhost:5432/appdb
DB_NAME=appdb
DB_USERNAME=appuser
# INFRA-011: 弱いデフォルトパスワードを廃止。必ず強力なパスワードに置き換えること
DB_PASSWORD=<REPLACE_ME>

# CORS 設定（本番では実際のフロントエンド URL に変更すること）
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com

# Spring プロファイル（prod を推奨）
SPRING_PROFILES_ACTIVE=prod

# ユーザー変更通知連携（不要な場合は空欄のままにする）
USER_CHANGE_ENDPOINT_URL=
USER_CHANGE_API_KEY=
